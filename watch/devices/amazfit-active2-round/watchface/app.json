{
  "configVersion": "v3",
  "app": {
    "appId": 1024001,
    "appName": "Mediavida",
    "appType": "watchface",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "jairo",
    "description": "Mediavida unread notifications for Amazfit Active 2"
  },
  "runtime": {
    "apiVersion": {
      "minVersion": "3.0",
      "compatible": "3.0",
      "target": "3.0"
    },
    "type": 0
  },
  "permissions": ["data:os.device.info", "device:os.alarm"],
  "targets": {
    "amazfit-active2-round": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        { "name": "amazfit-active2-round", "deviceSource": 8913153 },
        { "name": "amazfit-active2-round-alt", "deviceSource": 8913155 },
        { "name": "amazfit-active2-round-alt2", "deviceSource": 8913159 }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Mediavida"
    },
    "es-ES": {
      "appName": "Mediavida"
    }
  },
  "defaultLanguage": "en-US"
}
